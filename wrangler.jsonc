
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadow-card-lab-v999",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shadow-card-lab-events",
      "database_id": "30b4203d-018b-4804-a887-e1676d5eeeeb"
    }
  ]
}
